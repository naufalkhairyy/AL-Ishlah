{
  "info": {
    "name": "CBT Santri API - Collection Runner Tests",
    "description": "Automated Postman Collection Runner flow for CBT Santri API. Run sequentially from top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run_suffix') || pm.collectionVariables.get('run_suffix').includes('{{')) {",
          "  pm.collectionVariables.set('run_suffix', Date.now().toString());",
          "}",
          "const pad = (value) => String(value).padStart(2, '0');",
          "const formatDate = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;",
          "pm.collectionVariables.set('schedule_date', formatDate(new Date()));",
          "pm.collectionVariables.set('schedule_start', '00:00');",
          "pm.collectionVariables.set('schedule_end', '23:59');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time below 5s', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "admin_username",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": "admin123"
    },
    {
      "key": "santri_username",
      "value": "santri_test{{run_suffix}}"
    },
    {
      "key": "santri_password",
      "value": "password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "santri_token",
      "value": ""
    },
    {
      "key": "registered_user_id",
      "value": ""
    },
    {
      "key": "cleanup_user_id",
      "value": "0"
    },
    {
      "key": "run_suffix",
      "value": "{{$timestamp}}"
    },
    {
      "key": "schedule_date",
      "value": ""
    },
    {
      "key": "schedule_start",
      "value": ""
    },
    {
      "key": "schedule_end",
      "value": ""
    },
    {
      "key": "santri_id",
      "value": ""
    },
    {
      "key": "ujian_id",
      "value": ""
    },
    {
      "key": "soal_id",
      "value": ""
    },
    {
      "key": "jadwal_id",
      "value": ""
    },
    {
      "key": "pembayaran_id",
      "value": ""
    },
    {
      "key": "jawaban_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/test"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Health response is OK', function () {",
              "  pm.expect(json.status).to.eql(true);",
              "  pm.expect(json.message).to.eql('API MASUK');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Register Santri Account (Performance /register)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{santri_username}}\",\n  \"password\": \"{{santri_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Santri account registered', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Register response has santri token', function () {",
              "  pm.expect(json.status).to.eql(true);",
              "  pm.expect(json.data.user.user_id).to.exist;",
              "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('registered_user_id', json.data.user.user_id);",
              "pm.collectionVariables.set('santri_token', json.data.token);"
            ]
          }
        }
      ]
    },
