          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/pembayaran"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pembayaran created or updated', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Pembayaran response has id', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.pembayaran_id).to.exist;",
