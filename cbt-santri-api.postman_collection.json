            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "ujian_id",
              "value": "{{ujian_id}}",
              "type": "text"
            },
            {
              "key": "judul_soal",
              "value": "Soal dari file Word",
              "type": "text"
            },
            {
              "key": "file_soal",
              "type": "file",
              "src": "samples/contoh_soal_word_admin.docx"
            },
            {
              "key": "jenis_soal",
              "value": "essay",
              "type": "text"
            },
            {
              "key": "durasi_pengerjaan",
              "value": "60",
              "type": "text"
            },
            {
              "key": "jawaban_benar",
              "value": "",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/soal"
      }
    },
    {
      "name": "Soal - Import XLSX/CSV",
      "request": {
        "method": "POST",
