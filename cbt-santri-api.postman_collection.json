{
  "info": {
    "name": "CBT Santri API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ujian_id",
      "value": "1"
    },
    {
      "key": "santri_id",
      "value": "1"
    },
    {
      "key": "soal_id",
      "value": "1"
    },
    {
      "key": "jadwal_id",
      "value": "1"
    },
    {
      "key": "jawaban_id",
      "value": "1"
    },
    {
      "key": "pembayaran_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/login"
      }
    },
    {
      "name": "Auth - Admin Login",
