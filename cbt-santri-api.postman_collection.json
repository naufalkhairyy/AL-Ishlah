    {
      "name": "Soal - Create Upload Word",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.soal_id) {",
              "  pm.collectionVariables.set('soal_id', json.data.soal_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
